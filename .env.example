# Base URL of the FastAPI backend (Nginx routes /api/* to it).
NEXT_PUBLIC_API_BASE_URL=/api

# true  -> UI runs entirely on the in-repo mock data (lib/mock), no backend needed.
# false -> UI calls the real REST API at NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_USE_MOCK_API=true

# Cloudflare Turnstile site key. Empty = a visual placeholder is rendered instead of the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Web Analytics beacon token. Empty = no beacon.
NEXT_PUBLIC_CF_BEACON_TOKEN=
